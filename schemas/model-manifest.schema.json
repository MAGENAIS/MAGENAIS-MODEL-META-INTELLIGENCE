{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MAGENAIS/MAGENAIS-MODELS/schemas/model-manifest.schema.json",
  "title": "MAGENAIS Model Manifest",
  "description": "Static descriptive metadata every MAGENAIS model (built-in or externally installed) must satisfy. Mirrors the ModelManifest TypeScript interface used internally by MAGENAIS (MASTER PROMPT V4.1 \u00a711). V5 Phase 1 extends this with the \u00a78 cognitive-contract fields (layer, family, problem, inputs/outputs, dependencies, scientificStatus, evidenceLevel, failureModes, composability, provenance and related). Every added field is OPTIONAL: a V4.1-era manifest that declares none of them still validates unchanged (\u00a715). The extension was required rather than optional because this schema sets additionalProperties:false, so a V5 manifest would otherwise fail validation here.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "type",
    "capabilities",
    "runtimes",
    "license",
    "pricing",
    "trust"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier, independent of any GitHub URL. Convention: \"magenais.<kebab-case-name>\".",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "examples": [
        "magenais.decision-score"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the model itself, independent of MAGENAIS's own version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "algorithm",
        "ml",
        "llm",
        "vision",
        "audio",
        "graph",
        "hybrid"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "examples": [
        [
          "builtin-local"
        ],
        [
          "api"
        ]
      ]
    },
    "license": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "SPDX identifier where possible, e.g. \"Apache-2.0\", \"MIT\".",
          "examples": [
            "Apache-2.0",
            "MIT"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pricing": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "free",
            "paid",
            "freemium",
            "enterprise"
          ]
        }
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "magenais-verified",
        "community-verified",
        "experimental",
        "unverified"
      ]
    },
    "uri": {
      "type": "string",
      "description": "Optional canonical URI form.",
      "pattern": "^magenais://[a-z0-9-]+@\\d+\\.\\d+\\.\\d+$",
      "examples": [
        "magenais://decision-score@1.0.0"
      ]
    },
    "repository": {
      "type": "string",
      "description": "Optional link to the model's own repository, for display only \u2014 never used as its identity.",
      "format": "uri"
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    },
    "demo": {
      "type": "string",
      "description": "Optional link to the model's own standalone demo/landing page (each model repository ships its own self-contained index.html), distinct from documentation (README/docs) and repository (source).",
      "format": "uri"
    },
    "artifact": {
      "type": "object",
      "description": "Present only on an entry for a model installed from an external artifact rather than one built into MAGENAIS. Added in Phase 16 (Installer/Catalog Foundation, MASTER PROMPT V4.1 \u00a732-34); none of the three initial models set this.",
      "required": [
        "url",
        "checksum"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checksum": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "description": "Lowercase hex-encoded digest.",
              "pattern": "^[0-9a-f]+$"
            }
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "primitive",
        "native-model",
        "composite-model",
        "cognitive-system"
      ],
      "description": "Position in the V5 \u00a73 hierarchy: primitives -> native models -> composite models -> cognitive systems."
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "description": "Cognitive family grouping, e.g. epistemic, causal, wisdom. Free-form with well-known values."
    },
    "purpose": {
      "type": "string",
      "description": "The capability this model provides, in one sentence (V5 \u00a74 Objective)."
    },
    "problem": {
      "type": "string",
      "description": "The cognitive problem this model exists to solve (V5 \u00a74 Problem)."
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What this model explicitly does not attempt."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Stable name for this input/output type; used as a node name in the capability graph."
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "schemaRef": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Stable name for this input/output type; used as a node name in the capability graph."
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "schemaRef": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "description": "V5 \u00a714. Capability-level dependencies are strongly preferred over model-level ones.",
      "properties": {
        "requiresCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optionalCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiresModels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "synchronous",
        "asynchronous",
        "streaming",
        "batch"
      ]
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "gpu": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "externalApi": {
          "type": "boolean"
        },
        "latencyExpectation": {
          "type": "string"
        }
      }
    },
    "scientificStatus": {
      "type": "string",
      "enum": [
        "established",
        "emerging",
        "experimental",
        "speculative"
      ],
      "description": "V5 \u00a77 epistemic label applied to the model's own mechanism."
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "none",
        "unit-tested",
        "benchmarked",
        "baseline-compared",
        "ablated"
      ],
      "description": "How much evidence exists that this implementation does what it claims."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "false-positive",
              "false-negative",
              "degradation",
              "malformed-input",
              "edge-case",
              "adversarial",
              "dependency-failure",
              "unsupported-condition"
            ]
          }
        }
      },
      "description": "V5 \u00a727 failure taxonomy. A model is not complete merely because its happy path works."
    },
    "benchmarkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "not-ready",
        "gate-passed",
        "verified"
      ],
      "description": "V5 \u00a728 Quality Gate outcome."
    },
    "composability": {
      "type": "object",
      "required": [
        "independentlyExecutable"
      ],
      "additionalProperties": false,
      "properties": {
        "independentlyExecutable": {
          "type": "boolean"
        },
        "composesWith": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "providesCapabilityTo": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "basedOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "benchmarkedAtCodeVersion": {
          "type": "string"
        }
      }
    },
    "implementationStatus": {
      "type": "string",
      "enum": [
        "designed",
        "partial",
        "implemented",
        "deprecated"
      ]
    },
    "cognitivePassport": {
      "type": "string",
      "description": "Path or URL to this model's V5 \u00a79 Cognitive Passport."
    },
    "modelCard": {
      "type": "string",
      "description": "Path or URL to this model's V5 \u00a710 Model Card."
    }
  }
}
