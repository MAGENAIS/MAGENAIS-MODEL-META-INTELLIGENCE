{
  "name": "@magenais/meta-intelligence",
  "version": "2.0.0",
  "description": "MAGENAIS Meta-Intelligence V2: a zero-dependency, stateful cognitive orchestrator that records a task's path from problem to strategy alternatives, evaluation, composition boundary, execution plan, outcome, adaptation and cognitive trace, with provenance. It plans and records; it never executes.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./benchmark": "./src/benchmark/index.ts",
    "./model.json": "./model.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schemas",
    "examples",
    "docs",
    "model.json",
    "README.md",
    "MODEL_SPECIFICATION.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "example": "node --experimental-strip-types --no-warnings examples/01-basic-problem-to-strategy.mjs",
    "examples": "for f in examples/0*.mjs; do node --experimental-strip-types --no-warnings \"$f\" || exit 1; done",
    "benchmark": "node --experimental-strip-types --no-warnings scripts/run-benchmark.mjs",
    "manifest:sync": "node --experimental-strip-types --no-warnings scripts/write-manifest.mjs",
    "check": "npm run typecheck && npm test && npm run benchmark",
    "html:sync": "node --experimental-strip-types --no-warnings scripts/build-html.mjs"
  },
  "keywords": [
    "meta-intelligence",
    "orchestration",
    "cognitive-architecture",
    "strategy",
    "decision-support",
    "provenance",
    "magenais"
  ],
  "author": {
    "name": "MAGENAIS"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MAGENAIS/MAGENAIS-MODEL-META-INTELLIGENCE.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
